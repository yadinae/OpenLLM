# Hugging Face Spaces Dockerfile
# 自包含部署 — 从 GitHub 公开仓库直接安装
#
# 使用方式:
#   1. 在 hf.co 创建新 Space, 选择 Docker SDK
#   2. 将此 Dockerfile 放入 Space 仓库根目录
#   3. 在 Settings → Secrets 中添加 API Keys
#   4. 如需自定义配置, 在 Settings → Variables 中设置 OPENLLM_CONFIG (YAML 字符串)
#
# 环境变量:
#   OPENLLM_CONFIG  — YAML/JSON 配置字符串 (可选, 不设则用内置回退模式)
#   ROUTER_API_KEY  — 网关认证密钥 (可选)
#   DEEPSEEK_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY 等 — Provider API Keys
#   PORT            — 监听端口 (默认 7860, HF Spaces 要求)

FROM python:3.11-slim-bookworm AS builder

WORKDIR /build

# 安装 git (pip install git+https 需要)
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

# 修改 REBUILD_DATE 可强制重建缓存层（更新日期即可触发全新构建）
ARG REBUILD_DATE=2026-06-27

# 从 GitHub 公开仓库直接安装
RUN pip install --no-cache-dir git+https://github.com/yadinae/OpenLLM.git

# ── 运行镜像 ──────────────────────────────
FROM python:3.11-slim-bookworm

# HF Spaces 要求: UID 1000, 工作目录 /home/user/app
RUN useradd -m -u 1000 user

USER user
ENV HOME=/home/user \
    PATH=/home/user/.local/bin:$PATH
WORKDIR $HOME/app

# 从 builder 复制安装好的包和 CLI 入口
COPY --from=builder --chown=user \
    /usr/local/lib/python3.11/site-packages \
    /usr/local/lib/python3.11/site-packages
COPY --from=builder --chown=user \
    /usr/local/bin/openllm \
    /usr/local/bin/openllm

EXPOSE 7860

ENV HOST=0.0.0.0
ENV PORT=7860

CMD ["openllm", "serve"]
